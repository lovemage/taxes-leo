{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "9max 模擬平台",
  "version": "0.1.8",
  "identifier": "com.zhiliu.ninemax",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --filter @taxes-leo/ui dev",
    "beforeBuildCommand": "pnpm --filter @taxes-leo/ui build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "9max 模擬平台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-TW"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
